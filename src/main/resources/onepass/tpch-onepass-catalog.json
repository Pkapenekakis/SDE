{
  "dataset": {
    "name": "tpch",
    "defaultScaleFactor": 1,
    "tables": {
      "customer": {
        "file": "customer.tbl",
        "separator": "|",
        "columns": [
          "c_custkey",
          "c_name",
          "c_address",
          "c_nationkey",
          "c_phone",
          "c_acctbal"
        ]
      },
      "orders": {
        "file": "orders.tbl",
        "separator": "|",
        "columns": [
          "o_orderkey",
          "o_custkey",
          "o_status",
          "o_totalprice"
        ]
      },
      "lineitem": {
        "file": "lineitem.tbl",
        "separator": "|",
        "columns": [
          "l_orderkey",
          "l_partkey",
          "l_suppkey",
          "l_linenumber",
          "l_quantity",
          "l_extendedprice",
          "l_discount",
          "l_tax",
          "l_returnflag",
          "l_linestatus",
          "l_shipdate",
          "l_commitdate",
          "l_receiptdate",
          "l_shipinstruct",
          "l_shipmode",
          "l_comment"
        ]
      },
      "supplier": {
        "file": "supplier.tbl",
        "separator": "|",
        "columns": [
          "s_suppkey",
          "s_name",
          "s_address",
          "s_nationkey",
          "s_phone",
          "s_acctbal",
          "s_comment"
        ]
      },
      "nation": {
        "file": "nation.tbl",
        "separator": "|",
        "columns": [
          "n_nationkey",
          "n_name",
          "n_regionkey",
          "n_comment"
        ]
      }
    }
  },
  "queries": {
    "q3": {
      "description": "TPC-H Q3 customer-orders-lineitem join",
      "defaultRoot": "customer",
      "relations": [
        {
          "alias": "customer",
          "table": "customer"
        },
        {
          "alias": "orders",
          "table": "orders"
        },
        {
          "alias": "lineitem",
          "table": "lineitem"
        }
      ],
      "joins": [
        {
          "leftAlias": "customer",
          "leftField": "c_custkey",
          "rightAlias": "orders",
          "rightField": "o_custkey"
        },
        {
          "leftAlias": "orders",
          "leftField": "o_orderkey",
          "rightAlias": "lineitem",
          "rightField": "l_orderkey"
        }
      ],
      "projection": [
        "customer.c_custkey",
        "orders.o_orderkey",
        "lineitem.l_linenumber"
      ],
      "defaultWeightsByAlias": {
        "customer": "1",
        "orders": "1",
        "lineitem": "1"
      }
    },
    "wq3_alias": {
      "description": "Weighted TPC-H Q3 with aliases c-o-l",
      "defaultRoot": "c",
      "relations": [
        {
          "alias": "c",
          "table": "customer"
        },
        {
          "alias": "o",
          "table": "orders"
        },
        {
          "alias": "l",
          "table": "lineitem"
        }
      ],
      "joins": [
        {
          "leftAlias": "c",
          "leftField": "c_custkey",
          "rightAlias": "o",
          "rightField": "o_custkey"
        },
        {
          "leftAlias": "o",
          "leftField": "o_orderkey",
          "rightAlias": "l",
          "rightField": "l_orderkey"
        }
      ],
      "projection": [
        "c.c_custkey",
        "o.o_orderkey",
        "l.l_linenumber"
      ],
      "defaultWeightsByAlias": {
        "c": "1",
        "o": "o_totalprice",
        "l": "l_extendedprice"
      }
    },
    "w_two_lineitems": {
      "description": "Tree query with two lineitem aliases connected through orders",
      "defaultRoot": "o",
      "relations": [
        {
          "alias": "o",
          "table": "orders"
        },
        {
          "alias": "l1",
          "table": "lineitem"
        },
        {
          "alias": "l2",
          "table": "lineitem"
        }
      ],
      "joins": [
        {
          "leftAlias": "o",
          "leftField": "o_orderkey",
          "rightAlias": "l1",
          "rightField": "l_orderkey"
        },
        {
          "leftAlias": "o",
          "leftField": "o_orderkey",
          "rightAlias": "l2",
          "rightField": "l_orderkey"
        }
      ],
      "projection": [
        "o.o_orderkey",
        "l1.l_linenumber",
        "l2.l_linenumber"
      ],
      "defaultWeightsByAlias": {
        "o": "o_totalprice",
        "l1": "l_extendedprice",
        "l2": "l_extendedprice"
      }
    },
    "wqx_alias": {
      "description": "Weighted TPC-H QX-style tree with aliases nat-sup-cus-ord-lin",
      "defaultRoot": "nat",
      "relations": [
        {
          "alias": "nat",
          "table": "nation"
        },
        {
          "alias": "sup",
          "table": "supplier"
        },
        {
          "alias": "cus",
          "table": "customer"
        },
        {
          "alias": "ord",
          "table": "orders"
        },
        {
          "alias": "lin",
          "table": "lineitem"
        }
      ],
      "joins": [
        {
          "leftAlias": "nat",
          "leftField": "n_nationkey",
          "rightAlias": "sup",
          "rightField": "s_nationkey"
        },
        {
          "leftAlias": "sup",
          "leftField": "s_nationkey",
          "rightAlias": "cus",
          "rightField": "c_nationkey"
        },
        {
          "leftAlias": "cus",
          "leftField": "c_custkey",
          "rightAlias": "ord",
          "rightField": "o_custkey"
        },
        {
          "leftAlias": "ord",
          "leftField": "o_orderkey",
          "rightAlias": "lin",
          "rightField": "l_orderkey"
        }
      ],
      "projection": [
        "nat.n_nationkey",
        "sup.s_suppkey",
        "cus.c_custkey",
        "ord.o_orderkey",
        "lin.l_linenumber"
      ],
      "defaultWeightsByAlias": {
        "nat": "1",
        "sup": "1",
        "cus": "1",
        "ord": "o_totalprice",
        "lin": "l_extendedprice"
      }
    },
    "w_branch_supplier": {
      "description": "Branching Phase-1 tree: nation root, supplier internal node with two lineitem children",
      "defaultRoot": "nat",
      "relations": [
        {
          "alias": "nat",
          "table": "nation"
        },
        {
          "alias": "sup",
          "table": "supplier"
        },
        {
          "alias": "l1",
          "table": "lineitem"
        },
        {
          "alias": "l2",
          "table": "lineitem"
        }
      ],
      "joins": [
        {
          "leftAlias": "nat",
          "leftField": "n_nationkey",
          "rightAlias": "sup",
          "rightField": "s_nationkey"
        },
        {
          "leftAlias": "sup",
          "leftField": "s_suppkey",
          "rightAlias": "l1",
          "rightField": "l_suppkey"
        },
        {
          "leftAlias": "sup",
          "leftField": "s_suppkey",
          "rightAlias": "l2",
          "rightField": "l_suppkey"
        }
      ],
      "projection": [
        "nat.n_nationkey",
        "sup.s_suppkey",
        "l1.l_linenumber",
        "l2.l_linenumber"
      ],
      "defaultWeightsByAlias": {
        "nat": "1",
        "sup": "1",
        "l1": "l_extendedprice",
        "l2": "l_extendedprice"
      }
    }
  }
}